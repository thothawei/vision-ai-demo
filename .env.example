# LLM 引擎：ollama（預設，本機離線）或 gemini（免費層備援，RPM=5 / RPD=20）
LLM_ENGINE=ollama
OLLAMA_MODEL=qwen3.5:9b
# 模型閒置多久後從記憶體釋放（16GB 機器建議別設太長）
OLLAMA_KEEP_ALIVE=5m

# 只有 LLM_ENGINE=gemini 時需要
GEMINI_API_KEY=your_api_key_here

# Phase 9：是否把每次辨識的原圖與標註圖存到 data/images/YYYY-MM-DD/（供追溯與複判）
SAVE_IMAGES=true

# Phase 10：/api/inspections* 的 X-API-Key 白名單，格式 名稱:key,名稱:key
# frontend 這組 key 要跟 frontend/index.html 的 FRONTEND_API_KEY 常數一致（單機 demo 的取捨，見 README）
# 正式環境請務必改成隨機字串，不要用這組預設值
API_KEYS=erp:dev-erp-key-change-me,frontend:dev-frontend-key-change-me

# 允許呼叫的前端網域白名單（逗號分隔），預設只允許本機
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# 單張上傳圖片大小上限（MB），超過回 413
MAX_UPLOAD_MB=20

# （選用）NG 時非同步 POST 精簡 JSON 到這個 URL；留空就完全不啟用 webhook
ERP_WEBHOOK_URL=
