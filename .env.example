# LLM 引擎：ollama（預設，本機離線）或 gemini（免費層備援，RPM=5 / RPD=20）
LLM_ENGINE=ollama
OLLAMA_MODEL=qwen3.5:9b
# 模型閒置多久後從記憶體釋放（16GB 機器建議別設太長）
OLLAMA_KEEP_ALIVE=5m

# 只有 LLM_ENGINE=gemini 時需要
GEMINI_API_KEY=your_api_key_here

# Phase 9：是否把每次辨識的原圖與標註圖存到 data/images/YYYY-MM-DD/（供追溯與複判）
SAVE_IMAGES=true

# 系統對系統的 X-API-Key 白名單，格式 名稱:key,名稱:key（給 ERP 輪詢、資料夾監控腳本用；只能辨識與唯讀）
# 瀏覽器使用者改用帳號登入，不需要 key。請換成隨機字串，不要用這組預設值
API_KEYS=erp:dev-erp-key-change-me,watcher:dev-watcher-key-change-me

# 登入 session 的簽章密鑰，至少 32 字元；沒設定服務會拒絕啟動
# 產生：python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# 允許呼叫的前端網域白名單（逗號分隔），預設只允許本機
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# 單張上傳圖片大小上限（MB），超過回 413
MAX_UPLOAD_MB=20

# （選用）NG 時非同步 POST 精簡 JSON 到這個 URL；留空就完全不啟用 webhook
ERP_WEBHOOK_URL=

# Phase 11：M5 短影片端點（/api/safety/video、/api/safety/ppe/video）的影片檔大小上限（MB）
MAX_VIDEO_MB=200

# 日誌層級（DEBUG／INFO／WARNING／ERROR），改了要重啟
LOG_LEVEL=INFO
